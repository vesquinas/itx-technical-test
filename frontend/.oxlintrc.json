{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc",
    "unicorn",
    "jsx-a11y",
    "react-perf",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],

    // Unnecessary with the modern JSX transform (`jsx: "react-jsx"`).
    "react/react-in-jsx-scope": "off",

    // Security: React escapes text by default and the risk appears precisely when you step off
    // that path, so it is closed by configuration.
    "react/no-danger": "error",
    "react/jsx-no-script-url": "error",
    "react/jsx-no-target-blank": "error",
    "no-eval": "error",
    "no-script-url": "error",

    "eqeqeq": ["error", "always"],
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",

    // Accessibility. Bundled with oxlint, no extra dependencies needed.
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/img-redundant-alt": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/no-autofocus": "warn",
    "jsx-a11y/role-has-required-aria-props": "error",

    // Disabled on purpose: they only have an effect when the prop reaches a component memoised
    // with React.memo. Passing an inline function to a DOM element (<input onChange>) causes no
    // extra render at all. Applied everywhere they force wrapping every handler in useCallback,
    // which adds noise and allocations without improving anything measurable.
    "react-perf/jsx-no-new-function-as-prop": "off",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "react-perf/jsx-no-new-array-as-prop": "off",

    // React Router requires passing the element as a prop (`<Route element={...}>`), so this
    // rule has no way of being satisfied in the route definitions.
    "react-perf/jsx-no-jsx-as-prop": "off",

    // Unicorn style rules that clash with the usual React idiom.
    "unicorn/no-array-for-each": "off",
    "unicorn/prefer-query-selector": "off"
  },
  "overrides": [
    {
      // Los scripts de linea de comandos informan por la salida estandar: es su
      // interfaz, no una traza olvidada.
      "files": ["scripts/**"],
      "rules": {
        // Command-line scripts report on standard output: that is their interface, not a
        // forgotten trace.
        "no-console": "off",
        // Sequential awaiting per batch is the mechanism that limits concurrency against the
        // API. What the rule suggests — awaiting every promise at once — would fire a hundred
        // simultaneous requests, which is exactly what we want to avoid.
        "no-await-in-loop": "off"
      }
    },
    {
      // The assertion lives in `expectNoAccessibilityViolations`, a shared helper, so the rule
      // cannot see it inside the test body. We teach it the name instead of disabling the check.
      "files": ["**/accessibility.test.tsx"],
      "rules": {
        "vitest/expect-expect": [
          "error",
          { "assertFunctionNames": ["expect", "expectNoAccessibilityViolations"] }
        ]
      }
    },
    {
      // In the tests a `javascript:` URL is the input of the check: these are precisely the
      // tests verifying that such URLs are rejected. The rule looks for `javascript:` in
      // attributes the browser executes, not in test data.
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "no-script-url": "off"
      }
    }
  ]
}
